[{"id":112,"fr":"être","infinitif":"jessi","aspect":"irrégulier","paire_aspect":null,"groupe":"irrégulier","present":{"jo":"o soi","tu":"tu sês","lui":"al è","nô":"o sin","vô":"o sês","lôr":"a son"},"passe":{"jo":"o soi stât","tu":"tu sês stât","lui":"al è stât","nô":"o sin stâts","vô":"o sês stâts","lôr":"a son stâts"},"imparfait":{"jo":"o jeri","tu":"tu jeris","lui":"al jera","nô":"o jerin","vô":"o jeris","lôr":"a jerin"},"futur":{"jo":"o sarai","tu":"tu sarâs","lui":"al sarà","nô":"o sarìn","vô":"o sarês","lôr":"a saran"},"imperatif":{"tu":null,"vô":null},"note":"Verbe le plus important : les pronoms clitiques (o, tu, al, o, o, a) sont obligatoires et inséparables de la forme verbale. Auxiliaire jessi (o soi stât). À Udine on dit al jere à l'imparfait ; à l'ouest (Maniago, Pordenone) c'est al jera, avec -a final, et on entend aussi al era, o eri sans j. Dans beaucoup de villages de l'ouest le clitique de 1re personne est i au lieu de o : i soi, i sin, i sês."},{"id":1317,"fr":"avoir","infinitif":"vê","aspect":"irrégulier","paire_aspect":null,"groupe":"irrégulier","present":{"jo":"o ai","tu":"tu âs","lui":"al à","nô":"o vin","vô":"o vês","lôr":"a àn"},"passe":{"jo":"o ai vût","tu":"tu âs vût","lui":"al à vût","nô":"o vin vût","vô":"o vês vût","lôr":"a àn vût"},"imparfait":{"jo":"o vevi","tu":"tu vevis","lui":"al veva","nô":"o vevin","vô":"o vevis","lôr":"a vevin"},"futur":{"jo":"o varai","tu":"tu varâs","lui":"al varà","nô":"o varìn","vô":"o varês","lôr":"a varan"},"imperatif":{"tu":null,"vô":null},"note":"Auxiliaire de la grande majorité des verbes. Participe vût. Imparfait 3e pers. al veva à l'ouest, al veve à Udine. Sert aussi aux locutions : o ai fam (j'ai faim), o ai sêt (j'ai soif)."},{"id":398,"fr":"aller","infinitif":"lâ","aspect":"irrégulier","paire_aspect":null,"groupe":"irrégulier","present":{"jo":"o voi","tu":"tu vâs","lui":"al va","nô":"o lin","vô":"o lais","lôr":"a van"},"passe":{"jo":"o soi lât","tu":"tu sês lât","lui":"al è lât","nô":"o sin lâts","vô":"o sês lâts","lôr":"a son lâts"},"imparfait":{"jo":"o levi","tu":"tu levis","lui":"al leva","nô":"o levin","vô":"o levis","lôr":"a levin"},"futur":{"jo":"o larai","tu":"tu larâs","lui":"al larà","nô":"o larìn","vô":"o larês","lôr":"a laran"},"imperatif":{"tu":"va","vô":"lait"},"note":"Auxiliaire jessi : o soi lât (je suis allé), au féminin o soi lade. Le radical change complètement : va- au présent, l- ailleurs. Imparfait al leva à l'ouest, al leve à Udine."},{"id":181,"fr":"faire","infinitif":"fâ","aspect":"irrégulier","paire_aspect":null,"groupe":"irrégulier","present":{"jo":"o fâs","tu":"tu fâs","lui":"al fâs","nô":"o fasìn","vô":"o fasês","lôr":"a fasin"},"passe":{"jo":"o ai fat","tu":"tu âs fat","lui":"al à fat","nô":"o vin fat","vô":"o vês fat","lôr":"a àn fat"},"imparfait":{"jo":"o fasevi","tu":"tu fasevis","lui":"al faseva","nô":"o fasevin","vô":"o fasevis","lôr":"a fasevin"},"futur":{"jo":"o farai","tu":"tu farâs","lui":"al farà","nô":"o farìn","vô":"o farês","lôr":"a faran"},"imperatif":{"tu":"fâs","vô":"fasêt"},"note":"Participe irrégulier fat. Les trois premières personnes du singulier sont identiques (fâs) : seul le clitique les distingue, ce qui montre pourquoi il est obligatoire."},{"id":600,"fr":"dire","infinitif":"dî","aspect":"irrégulier","paire_aspect":null,"groupe":"irrégulier","present":{"jo":"o dîs","tu":"tu dîs","lui":"al dîs","nô":"o disìn","vô":"o disês","lôr":"a disin"},"passe":{"jo":"o ai dit","tu":"tu âs dit","lui":"al à dit","nô":"o vin dit","vô":"o vês dit","lôr":"a àn dit"},"imparfait":{"jo":"o disevi","tu":"tu disevis","lui":"al diseva","nô":"o disevin","vô":"o disevis","lôr":"a disevin"},"futur":{"jo":"o disarai","tu":"tu disarâs","lui":"al disarà","nô":"o disarìn","vô":"o disarês","lôr":"a disaran"},"imperatif":{"tu":"dîs","vô":"disêt"},"note":"Participe irrégulier dit. Radical dis- devant les désinences longues."},{"id":1319,"fr":"venir","infinitif":"vignî","aspect":"irrégulier","paire_aspect":null,"groupe":"irrégulier","presen